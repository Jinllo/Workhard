// Despliegue en Cloudflare Workers con archivos estáticos (sin código de servidor).
// El build lo ejecuta Cloudflare con el comando configurado en el panel (npm run build);
// las variables VITE_* están en Settings → Build → Variables and secrets.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "workhard",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // Rutas como /login o /personal devuelven index.html y React decide qué mostrar.
    "not_found_handling": "single-page-application"
  }
}
