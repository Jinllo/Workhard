# Copia este archivo a .env.local (no se sube a git) y completa los valores.
# En Supabase: Project Settings → API Keys.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Solo la clave PÚBLICA (publishable "sb_publishable_..." o la anon heredada).
# Nunca la secret key ni la service_role: la app se niega a arrancar con ellas.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
